/* Lavender dreamy theme */
body {
    background-color: #F5F0FF;
    color: #493D64;
    font-family: Arial, sans-serif;
    line-height: 1.7;
}

/* Headings */
h1, h2, h3 {
    color: #7656A6;
    font-family: Georgia, serif;
}

/* Navigation bar */
nav, .navbar {
    background-color: #E5D8FA;
}

/* Content cards */
.card {
    background-color: #FFFFFF;
    border: 1px solid #E5D8FA;
    border-radius: 18px;
    box-shadow: 0 4px 12px rgba(118, 86, 166, 0.10);
    margin-bottom: 20px;
}

/* Buttons */
button, .btn {
    background-color: #C6AFE8;
    color: #352748;
    border: none;
    border-radius: 25px;
    padding: 10px 20px;
    transition: 0.3s;
}

button:hover, .btn:hover {
    background-color: #B49AD9;
    color: #352748;
    transform: translateY(-2px);
}

/* Images */
img {
    max-width: 100%;
    height: auto;
    border-radius: 15px;
}

/* Links */
a {
    color: #7656A6;
}

a:hover {
    color: #493D64;
}

/* Form fields */
input, textarea, select {
    border: 1px solid #D7C6F0;
    border-radius: 10px;
    padding: 10px;
}

/* Space out sections */
section {
    padding-top: 20px;
    padding-bottom: 20px;
}
